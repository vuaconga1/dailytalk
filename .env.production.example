# Production config for https://dailytalk.wewin.edu.vn — copy to .env on the server.
AI_MODE=demo
APP_ORIGIN=https://dailytalk.wewin.edu.vn
# Docker: HOST/PORT/DATA_DIR are set in docker-compose.yml.
# systemd + nginx: keep the app bound to localhost behind nginx.
HOST=127.0.0.1
PORT=8000
DATA_DIR=/var/lib/wewin-dailytalk
# Use the client IP from X-Forwarded-For (only behind a trusted reverse proxy).
TRUST_PROXY=1
MAX_PROVIDER_CALLS_PER_USER_DAY=90
# For AI_MODE=openai fill all of these:
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_VOICE=alloy
