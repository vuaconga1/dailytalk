# Neon Postgres — lấy connection string từ https://console.neon.tech
# Dùng pooled URL (?sslmode=require) cho Vercel / serverless
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Ký cookie phiên đăng nhập (bắt buộc trên production, ≥16 ký tự)
SESSION_SECRET="change-me-to-a-long-random-string"

# demo: không gọi AI, không phát sinh phí. openai: dùng OpenAI thật (điền đủ các model bên dưới)
AI_MODE="demo"
OPENAI_API_KEY=""
# Text model phải hỗ trợ Responses API + JSON object output
OPENAI_TEXT_MODEL=""
# Model hỗ trợ /v1/audio/transcriptions
OPENAI_TRANSCRIBE_MODEL=""
# Model hỗ trợ /v1/audio/speech (mp3)
OPENAI_TTS_MODEL=""
OPENAI_VOICE="alloy"

# Số lần gọi AI tối đa mỗi học viên mỗi ngày (giờ Việt Nam)
MAX_PROVIDER_CALLS_PER_USER_DAY="90"

# URL công khai của app (dùng trong tin nhắn Zalo), không có dấu / cuối
APP_URL="https://daily.wewin.edu.vn"

# --- Cron ngoài (cron-job.org / Upstash QStash) -------------------------
# Gọi GET/POST {APP_URL}/api/cron/tick mỗi 5–10 phút với header
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# --- Zalo Official Account (tin tư vấn, miễn phí) -----------------------
# Bỏ trống = chạy thử: tin nhắn được ghi log, không gửi thật.
ZALO_APP_ID=""
# Secret key của app trên developers.zalo.me (dùng để refresh token)
ZALO_APP_SECRET=""
# Refresh token OA ban đầu; sau đó token mới được lưu & xoay vòng trong DB
ZALO_REFRESH_TOKEN=""
# OA Secret Key (Webhook) để xác thực chữ ký X-ZEvent-Signature
ZALO_OA_SECRET_KEY=""
# Link quan tâm OA hiển thị cho học viên, vd https://zalo.me/<oa_id>
ZALO_OA_URL=""
# Cửa sổ gửi tin tư vấn sau lần tương tác cuối của học viên (giờ)
ZALO_CS_WINDOW_HOURS="48"

# --- Cloudflare R2 (audio shadowing dùng chung) -------------------------
# Bỏ trống = lưu audio trong database
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# --- Tài khoản admin đầu tiên (npm run seed:admin) ----------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
