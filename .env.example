# Neon Postgres — lấy connection string từ https://console.neon.tech
# Dùng pooled URL (?sslmode=require) cho Vercel / serverless
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Ký cookie phiên đăng nhập (bắt buộc trên production, ≥16 ký tự)
SESSION_SECRET="change-me-to-a-long-random-string"

# demo: không gọi AI, không phát sinh phí. openai: dùng OpenAI thật (điền đủ các model bên dưới)
AI_MODE="demo"
OPENAI_API_KEY=""
# Text model phải hỗ trợ Responses API + JSON object output
OPENAI_TEXT_MODEL=""
# Model hỗ trợ /v1/audio/transcriptions
OPENAI_TRANSCRIBE_MODEL=""
# Model hỗ trợ /v1/audio/speech (mp3)
OPENAI_TTS_MODEL=""
OPENAI_VOICE="alloy"

# --- Kokoro TTS (miễn phí, chạy local để tạo trước audio shadowing + từ vựng) ---
#   docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
#   npm run audio:gen                  (bài trong ngân hàng)
#   npm run audio:gen -- --curriculum  (toàn bộ giáo trình, lâu)
# Production: bỏ trống TTS_BASE_URL nhưng giữ TTS_MODEL/TTS_VOICE giống máy local
# để khớp key cache; bài chưa có audio dùng giọng trình duyệt.
TTS_BASE_URL=""   # vd http://localhost:8880/v1
TTS_MODEL=""      # vd kokoro
TTS_VOICE=""      # vd af_heart, af_bella, am_michael, bf_emma

# Số lần gọi AI tối đa mỗi học viên mỗi ngày (giờ Việt Nam)
MAX_PROVIDER_CALLS_PER_USER_DAY="90"

# URL công khai của app (dùng trong tin nhắn Zalo), không có dấu / cuối
APP_URL="https://dailytalk.wewin.edu.vn"

# --- Cron bảo trì (1 lần/ngày là đủ) ------------------------------------
# Gọi GET/POST {APP_URL}/api/cron/tick với header
#   Authorization: Bearer <CRON_SECRET>
# Mặc định: expire + ensure (xếp lịch nhắc QStash) + weekly + recordings.
# Không cần poll 5–10 phút nữa — nhắc học do QStash gọi đúng giờ.
CRON_SECRET=""

# --- QStash (nhắc học đúng giờ từng học viên) ---------------------------
# Console: https://console.upstash.com/qstash — Free ~1.000 msg/ngày.
# Copy QSTASH_TOKEN + hai signing keys vào đây / Vercel.
# Callback: POST {APP_URL}/api/qstash/study-reminder (ký bởi QStash).
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Email nhắc học (Resend — phù hợp Vercel free/Hobby) ----------------
# Free: ~3.000 email/tháng, 100/ngày. Đăng ký https://resend.com
# Bỏ trống RESEND_API_KEY hoặc EMAIL_FROM = dry-run (ghi log, không gửi).
# Dev nhanh: From = WeWIN Daily Speaking <onboarding@resend.dev>
#   (Resend chỉ cho gửi tới email tài khoản Resend của bạn).
# Production: Domains → Add wewin.edu.vn → xác thực DNS → dùng From bên dưới.
RESEND_API_KEY=""
EMAIL_FROM="WeWIN Daily Speaking <noreply@wewin.edu.vn>"

# --- Zalo Official Account (tin tư vấn, miễn phí) -----------------------
# Bỏ trống = chạy thử: tin nhắn được ghi log, không gửi thật.
# Checklist: https://developers.zalo.me → App gắn OA → Webhook HTTPS
#   {APP_URL}/api/zalo/webhook · sự kiện follow, unfollow, user_send_text
#   (tắt “Lọc cú pháp #” vì mã liên kết là WWxxxxxx)
# Lấy refresh token lần đầu: OA cấp quyền → authorization code →
#   npm run zalo:token -- --code <AUTHORIZATION_CODE>
ZALO_APP_ID=""
# Secret key của app trên developers.zalo.me (dùng để refresh token)
ZALO_APP_SECRET=""
# Refresh token OA ban đầu; sau đó token mới được lưu & xoay vòng trong DB (ZaloToken)
ZALO_REFRESH_TOKEN=""
# OA Secret Key (Webhook) để xác thực chữ ký X-ZEvent-Signature
ZALO_OA_SECRET_KEY=""
# Link quan tâm OA hiển thị cho học viên, vd https://zalo.me/<oa_id>
ZALO_OA_URL=""
# Cửa sổ gửi tin tư vấn sau lần tương tác cuối của học viên (giờ)
ZALO_CS_WINDOW_HOURS="48"

# --- Cloudflare R2 (audio shadowing dùng chung) -------------------------
# Bỏ trống = lưu audio trong database
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# --- Thanh toán QR (VietQR) + tự kích hoạt qua webhook SePay -------------
# "true" = bật luồng học thử → thanh toán → tự kích hoạt.
# Bỏ trống/khác "true" = học viên được kích hoạt gói 30 ngày ngay khi hoàn tất khảo sát; /payment trả 404.
PAYMENT_ENABLED="true"
# Bỏ trống 1 trong 3 dòng đầu = trang /payment báo "chưa cấu hình", không hiện QR.
# Mã ngân hàng: BIN (vd 970418) hoặc mã ngắn VietQR (vd BIDV, VCB, MB)
PAYMENT_BANK_ID="BIDV"
PAYMENT_ACCOUNT_NO="8684006688"
# Tên chủ tài khoản, viết hoa không dấu
PAYMENT_ACCOUNT_NAME="CTY TNHH PHAT TRIEN DAO TAO GIAO DUC THANH CONG"
# Tên ngân hàng hiển thị cho học viên (mặc định = PAYMENT_BANK_ID)
PAYMENT_BANK_NAME="Ngân hàng BIDV - TP.HCM"
# SePay → Webhooks: URL {APP_URL}/api/payment/webhook, kiểu chứng thực "API Key", dán cùng key vào đây
SEPAY_WEBHOOK_KEY=""

# --- Tài khoản admin đầu tiên (npm run seed:admin) ----------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
