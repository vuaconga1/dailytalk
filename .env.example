# Copy to .env (never commit real secrets). Restart after edits.
AI_MODE=demo
HOST=127.0.0.1
PORT=8000
APP_ORIGIN=http://localhost:8000
# For AI_MODE=openai, fill ALL model names from current provider documentation.
# Text model must support Responses API + JSON object output.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
# Transcription model must support /v1/audio/transcriptions.
OPENAI_TRANSCRIBE_MODEL=
# Speech model must support /v1/audio/speech (mp3).
OPENAI_TTS_MODEL=
OPENAI_VOICE=alloy
# Optional: DATA_DIR=/absolute/persistent/path
